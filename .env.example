# ---------------------------------------------------------------------------
# Metro Lahore Kites — environment variables
# Copy this file to `.env` (server reads it from the repository root) and
# fill in real values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# HTTP port for the API + production static server
PORT=4000

# NODE_ENV is set automatically by `npm start` (production) / `npm run dev` (development)
# NODE_ENV=production

# Absolute path or relative path to the SQLite database file.
# Defaults to <repo>/server/data/metrolahorekites.db
# DATABASE_PATH=server/data/metrolahorekites.db

# Directory where admin-uploaded product images are stored (served at /uploads).
# UPLOADS_DIR=server/uploads

# --- First administrator account -------------------------------------------
# Created automatically on first start when no admin user exists yet.
# If ADMIN_PASSWORD is omitted a strong random password is generated and
# printed once to the server console so you can sign in and change it.
ADMIN_EMAIL=admin@metrolahorekites.pk
ADMIN_NAME=Metro Lahore Kites Admin
# ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Security ---------------------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Comma separated list of extra allowed origins for cookie-authenticated
# state-changing requests (defaults to the request host).
# ALLOWED_ORIGINS=https://example.com

# --- Business configuration -------------------------------------------------
# These values are also editable from Admin > Settings after first start.
# BUSINESS_WHATSAPP=            # international format, e.g. 923001234567 (no "+")
# BUSINESS_PHONE=
# BUSINESS_EMAIL=
